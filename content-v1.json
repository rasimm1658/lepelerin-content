        "eyebrow": {
          "en": "TASTING",
          "de": "PROBIEREN"
        },
        "title": {
          "en": "The first sip lies.",
          "de": "Der erste Schluck täuscht."
        },
        "text": {
          "en": "Coffee changes as it cools. The second and third sip often tell you more.",
          "de": "Kaffee verändert sich beim Abkühlen. Der zweite und dritte Schluck verraten oft mehr."
        }
      }
