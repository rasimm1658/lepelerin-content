  "guide": {
    "intro": {
      "eyebrow": {
        "en": "COFFEE NOTES",
        "de": "KAFFEE-NOTIZEN"
      },
      "title": {
        "en": "Small things worth knowing.",
        "de": "Ein paar Dinge über Kaffee."
      },
      "text": {
        "en": "Not a coffee textbook. Just a few quiet notes for people who are curious about what is in the cup.",
        "de": "Kein Lehrbuch. Nur ein paar ruhige Notizen für alle, die wissen wollen, was in der Tasse steckt."
      }
    },
    "notes": [
      {
        "id": "grind-fresh",
        "status": "active",
        "isFeatured": false,
        "eyebrow": {
          "en": "COFFEE NOTE 01 · whole beans",
          "de": "KAFFEE-NOTIZ 01 · ganze Bohnen"
        },
        "title": {
          "en": "Grind fresh. Always.",
          "de": "Immer frisch mahlen."
        },
        "text": {
          "en": "Ground coffee loses aroma quickly. That is why we sell our beans whole — and recommend grinding right before brewing.",
          "de": "Gemahlener Kaffee verliert schnell an Aroma. Deshalb verkaufen wir unsere Bohnen im Ganzen – und empfehlen, sie erst direkt vor dem Brühen zu mahlen."
        }
      },
      {
        "id": "filter-ratio",
        "status": "active",
        "isFeatured": false,
        "eyebrow": {
          "en": "FILTER",
          "de": "FILTER"
        },
        "title": {
          "en": "1:16 is a good start.",
          "de": "1:16 ist ein guter Anfang."
        },
        "text": {
          "en": "For filter coffee, try 1g of coffee to about 16g of water. From there, adjust by taste.",
          "de": "Für Filterkaffee: 1 g Kaffee auf etwa 16 g Wasser. Danach nach Geschmack anpassen."
        }
      },
      {
        "id": "taste-bitterness",
        "status": "active",
        "isFeatured": true,
        "eyebrow": {
          "en": "TASTE",
          "de": "GESCHMACK"
        },
        "title": {
          "en": "Bitter does not mean strong.",
          "de": "Bitter ist nicht gleich stark."
        },
        "text": {
          "en": "Bitterness can come from roast, grind size, water, temperature or extraction.",
          "de": "Bitterkeit kann an Röstung, Mahlgrad, Wasser, Temperatur oder Extraktion liegen."
        }
      },
      {
        "id": "filter-clarity",
        "status": "active",
        "isFeatured": false,
        "eyebrow": {
          "en": "FILTER",
          "de": "FILTER"
        },
        "title": {
          "en": "Filter is not weak.",
          "de": "Filterkaffee ist nicht schwach."
        },
        "text": {
          "en": "It is not lighter espresso. It is a clearer, longer way to taste the coffee.",
          "de": "Filterkaffee ist kein schwächerer Espresso. Er zeigt den Kaffee klarer und länger."
        }
      },
      {
        "id": "milk",
        "status": "active",
        "isFeatured": false,
        "eyebrow": {
          "en": "MILK",
          "de": "MILCH"
        },
        "title": {
          "en": "Milk changes everything.",
          "de": "Milch verändert alles."
        },
        "text": {
          "en": "It changes sweetness, texture and how bitterness feels — not just the colour.",
          "de": "Sie verändert Süße, Textur und wie Bitterkeit wirkt – nicht nur die Farbe."
        }
      },
      {
        "id": "temperature",
        "status": "active",
        "isFeatured": false,
        "eyebrow": {
          "en": "TEMPERATURE",
          "de": "TEMPERATUR"
        },
        "title": {
          "en": "Hotter is not always better.",
          "de": "Heißer ist nicht immer besser."
        },
        "text": {
          "en": "Very hot water can make coffee taste harsh. A little balance can do more than force.",
          "de": "Sehr heißes Wasser kann Kaffee harsch machen. Balance bringt oft mehr als Kraft."
        }
      },
      {
        "id": "tasting-first-sip",
